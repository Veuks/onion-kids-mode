+static void kidsmodeLog(const char *format, ...)
+{
+    if (access("/mnt/SDCARD/.kidmode", F_OK) != 0)
+        return;
+    FILE *fp = fopen(KIDSMODE_KEYMON_LOG, "a");
+    if (fp == NULL)
+        return;
+    fprintf(fp, "%ld keymon=%d ", (long)time(NULL), getpid());
+    va_list args;
+    va_start(args, format);
+    vfprintf(fp, format, args);
+    va_end(args);
+    fputc('\n', fp);
+    fclose(fp);
+}
