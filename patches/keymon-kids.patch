     }
     rumble(0);
     display_setBrightnessRaw(0);
+    if (temp_flag_get("kidsmode_carousel_active")) {
+        // kidui renders through the framebuffer. Give the backlight time to
+        // become fully dark before display_off() saves and clears that buffer,
+        // otherwise the clear can be visible as a one-frame flash.
+        msleep(100);
+    }
     display_off();
     system_powersave_on();
 
@@ -333,6 +339,12 @@ void suspend_exec(int timeout)
     display_setBrightness(settings.brightness);
     setVolume(settings.mute ? 0 : settings.volume);
     if (!killexit) {
+        if (temp_flag_get("kidsmode_carousel_active")) {
+            // Publish the completed POWER wake before SIGCONT. Otherwise
+            // kidui can run first, count the sleep interval as idle time and
+            // dim the freshly restored backlight before seeing this marker.
+            temp_flag_set("kidsmode_carousel_resume", true);
+        }
         // resume processes
         resume();
         // resume playActivity
@@ -353,6 +365,19 @@ void turnOffScreen(void)
     }
 }
 
+static void wakeKidsModeCarousel(void)
+{
+    // keymon is the sole owner of POWER. When Kids Mode has only dimmed or
+    // blanked its carousel, the first short press restores the screen and is
+    // consumed here. A second short press sees no marker and follows Onion's
+    // normal suspend path below.
+    system_powersave_off();
+    display_on();
+    display_setBrightness(settings.brightness);
+    temp_flag_set("kidsmode_carousel_dimmed", false);
+    temp_flag_set("kidsmode_carousel_wake", true);
+}
