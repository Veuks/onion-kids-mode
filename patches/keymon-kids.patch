diff --git a/src/keymon/keymon.c b/src/keymon/keymon.c
index 64f22a18..830310e8 100644
--- a/src/keymon/keymon.c
+++ b/src/keymon/keymon.c
@@ -262,6 +262,16 @@ void suspend_exec(int timeout)
 {
     keyinput_disable();
 
+    bool kidsmode_carousel_active =
+        temp_flag_get("kidsmode_carousel_active");
+    if (kidsmode_carousel_active) {
+        // Blank the backlight before stopping any process. kidui uses a
+        // double-buffered framebuffer, and stopping it or playActivity while
+        // the panel is still lit can expose one or more transitional frames.
+        display_setBrightnessRaw(0);
+        msleep(20);
+    }
+
     // pause playActivity
     system("playActivity stop_all");
 
@@ -275,7 +285,8 @@ void suspend_exec(int timeout)
         setVolume(0);
     }
     rumble(0);
-    display_setBrightnessRaw(0);
+    if (!kidsmode_carousel_active)
+        display_setBrightnessRaw(0);
     display_off();
     system_powersave_on();
 
@@ -333,6 +344,12 @@ void suspend_exec(int timeout)
     display_setBrightness(settings.brightness);
     setVolume(settings.mute ? 0 : settings.volume);
     if (!killexit) {
+        if (temp_flag_get("kidsmode_carousel_active")) {
+            // Publish the completed POWER wake before SIGCONT. Otherwise
+            // kidui can run first, count the sleep interval as idle time and
+            // dim the freshly restored backlight before seeing this marker.
+            temp_flag_set("kidsmode_carousel_resume", true);
+        }
         // resume processes
         resume();
         // resume playActivity
@@ -353,6 +370,20 @@ void turnOffScreen(void)
     }
 }
 
+static void wakeKidsModeCarousel(void)
+{
+    // keymon is the sole owner of POWER. When Kids Mode has only dimmed or
+    // blanked its carousel, the first short press restores the screen and is
+    // consumed here. A second short press sees no marker and follows Onion's
+    // normal suspend path below.
+    // The carousel dimmer changes only PWM brightness: the LCD panel and
+    // kidui never stopped. Calling display_on() here would unnecessarily
+    // reset the panel and expose a short black frame.
+    display_setBrightness(settings.brightness);
+    temp_flag_set("kidsmode_carousel_dimmed", false);
+    temp_flag_set("kidsmode_carousel_wake", true);
+}
+
 /**
