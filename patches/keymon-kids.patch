+static pid_t signalProcessByName(const char *name, int signal_number)
+{
+    DIR *proc = opendir("/proc");
+    if (proc == NULL)
+        return -1;
+
+    char expected[132];
+    snprintf(expected, sizeof(expected), "(%s)", name);
+    struct dirent *entry;
+    pid_t matched_pid = -1;
+    while ((entry = readdir(proc)) != NULL) {
+        if (entry->d_type != DT_DIR)
+            continue;
+        pid_t pid = atoi(entry->d_name);
+        if (pid <= 2 || pid == getpid())
+            continue;
+        char stat_path[64];
+        snprintf(stat_path, sizeof(stat_path), "/proc/%d/stat", pid);
+        FILE *fp = fopen(stat_path, "r");
+        if (fp == NULL)
+            continue;
+        char comm[128] = "";
+        int fields = fscanf(fp, "%*d %127s", comm);
+        fclose(fp);
+        if (fields == 1 && strcmp(comm, expected) == 0 &&
+            kill(pid, signal_number) == 0) {
+            matched_pid = pid;
+            break;
+        }
+    }
+    closedir(proc);
+    kidsmodeLog("signal target=%s signal=%d matched_pid=%d result=%s", name,
+                signal_number, matched_pid,
+                matched_pid > 2 ? "ok" : "not-found");
+    return matched_pid;
+}
