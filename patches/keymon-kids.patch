                 if (!comboKey_menu && val == REPEAT) {
                     repeat_power++;
                     if (repeat_power == 7) {
@@ -565,6 +600,10 @@ int main(void)
                         if (comboKey_menu) {
                             takeScreenshot();
                         }
+                        else if (carousel_dimmed_at_power_press) {
+                            // First short POWER press only wakes the carousel.
+                            wakeKidsModeCarousel();
+                        }
                         else {
                             if (settings.disable_standby) {
                                 deepsleep();
@@ -575,6 +614,7 @@ int main(void)
                         }
                     }
                     power_pressed = false;
+                    carousel_dimmed_at_power_press = false;
