+static void kidsmode_showVolumeBar(int volume, bool mute)
+{
+    // Onion volume steps are 5%: 15-17 = 75-85%, 18-20 = 90-100%.
+    const uint32_t kidsmode_orange = 0x00FF9F43;
+    const uint32_t kidsmode_muted_purple = 0x008044D7;
+    uint32_t color = mute ? kidsmode_muted_purple
+                          : (volume >= 18 ? OSD_COLOR_RED
+                             : volume >= 15 ? kidsmode_orange
+                                            : OSD_VOLUME_COLOR);
+    osd_showBar(volume, 20, color);
+}
