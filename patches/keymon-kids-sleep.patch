+static bool kidsmode_writeSystemSettings(cJSON *json)
+{
+    char path[PATH_MAX];
+    char temporary[PATH_MAX];
+    // Follow a possible Onion system.json symlink, then rename beside its
+    // real target. Preserve both the link and all unfamiliar JSON fields.
+    if (realpath(MAIN_UI_SETTINGS, path) == NULL ||
+        snprintf(temporary, sizeof(temporary), "%s.kidsmode.XXXXXX", path) >=
+            (int)sizeof(temporary))
+        return false;
+    char *output = cJSON_Print(json);
+    if (output == NULL)
+        return false;
+    int fd = mkstemp(temporary);
+    if (fd < 0) {
+        cJSON_free(output);
+        return false;
+    }
+    struct stat original;
+    if (stat(path, &original) == 0)
+        fchmod(fd, original.st_mode & 0777);
+    FILE *fp = fdopen(fd, "w");
+    if (fp == NULL) {
+        close(fd);
+        remove(temporary);
+        cJSON_free(output);
+        return false;
+    }
+    size_t size = strlen(output);
+    bool saved = fwrite(output, 1, size, fp) == size &&
+                 fflush(fp) == 0 && fsync(fd) == 0;
+    if (fclose(fp) != 0)
+        saved = false;
+    cJSON_free(output);
+    if (saved)
+        saved = rename(temporary, path) == 0;
+    if (!saved)
+        remove(temporary);
+    return saved;
+}
+
+static void kidsmode_saveSettings(void)
+{
+    cJSON *json = json_load(MAIN_UI_SETTINGS);
+    if (!cJSON_IsObject(json)) {
+        cJSON_Delete(json);
+        kidsmode_settings_changed_at = getMilliseconds();
+        return; // Keep pending values and retry without overwriting bad JSON.
+    }
+    const char *names[] = {"vol", "brightness", "mute"};
+    int values[] = {settings.volume, settings.brightness, settings.mute};
+    bool pending[] = {kidsmode_volume_dirty, kidsmode_brightness_dirty,
+                      kidsmode_mute_dirty};
+    bool changed = false;
+    bool valid = true;
+    for (int i = 0; i < 3 && valid; i++) {
+        if (!pending[i])
+            continue;
+        cJSON *property = cJSON_GetObjectItem(json, names[i]);
+        if (cJSON_IsNumber(property) &&
+            cJSON_GetNumberValue(property) == values[i])
+            continue;
+        cJSON *number = cJSON_CreateNumber(values[i]);
+        if (number == NULL) {
+            valid = false;
+            break;
+        }
+        valid = property != NULL
+                    ? cJSON_ReplaceItemInObject(json, names[i], number)
+                    : cJSON_AddItemToObject(json, names[i], number);
+        if (!valid)
+            cJSON_Delete(number);
+        changed = true;
+    }
+    bool saved = valid && (!changed || kidsmode_writeSystemSettings(json));
+    cJSON_Delete(json);
+    if (!saved) {
+        kidsmode_settings_changed_at = getMilliseconds();
+        return;
+    }
+    // Stock Onion obtains mute from this flag, not from the JSON property.
+    if (kidsmode_mute_dirty &&
+        config_flag_get(".muteVolume") != (settings.mute != 0))
+        config_flag_set(".muteVolume", settings.mute);
+    if (kidsmode_volume_dirty)
+        __settings.volume = settings.volume;
+    if (kidsmode_brightness_dirty)
+        __settings.brightness = settings.brightness;
+    if (kidsmode_mute_dirty)
+        __settings.mute = settings.mute;
+    kidsmode_volume_dirty = false;
+    kidsmode_brightness_dirty = false;
+    kidsmode_mute_dirty = false;
+    temp_flag_set("kidsmode_settings_pending", false);
+    if (changed)
+        temp_flag_set("settings_changed", true);
+}
